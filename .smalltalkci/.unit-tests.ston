SmalltalkCISpec {
  #loading : [
    SCIMetacelloLoadSpec {
      #baseline : 'ObjectPool',
      #directory : '../source',
      #load : [ 'Tests' ],
      #platforms : [ #pharo ],
      #failOn : [ #Warning ]
    }
  ],
  #testing : {
    #coverage : {
       #packages : [ 'ObjectPool*' ],
       #format: #lcov
    }
  }
}
